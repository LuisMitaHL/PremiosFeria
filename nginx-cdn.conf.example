# =============================================================================
# nginx-cdn.conf.example — deploy on YOUR CDN/proxy box (NOT used by compose).
# Copy to /etc/nginx/conf.d/ (or equivalent), set the 3 upstream IPs below
# to the docker host's published ports, reload nginx.
#
# Single public origin serves everything; TLS terminates on this box too
# (443 template at the bottom, disabled by default).
# =============================================================================

# --- upstreams: docker host IP + published compose ports --------------------
upstream app_web  { server 10.0.0.5:8080; }  # web  (WEB_PORT)
upstream app_rest { server 10.0.0.5:3000; }  # rest (REST_PORT)
upstream app_auth { server 10.0.0.5:9999; }  # auth (AUTH_PORT)

# --- microcache for hot reads ------------------------------------------------
# Dozens of phones poll the leaderboard every 5s: GET /rest/v1/* 200s are
# cached 5s (one upstream query per stampede), stale served while
# revalidating. Auth routes and writes are NEVER cached. Key includes
# apikey+Authorization so sessions can't leak across users.
# Observe: curl -I ... | grep -i x-microcache  (MISS -> HIT)
proxy_cache_path /var/cache/nginx/api levels=1:2 keys_zone=api:10m
                 max_size=100m inactive=60s use_temp_path=off;

server {
    listen 80;
    server_name feria.example.com;

    client_max_body_size 10m;

    location /auth/v1/ {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "$http_access_control_request_method" always;
            add_header Access-Control-Allow-Headers "$http_access_control_request_headers" always;
            add_header Access-Control-Max-Age "86400" always;
            return 204;
        }
        proxy_pass http://app_auth/;
        proxy_pass_request_headers on;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Access-Control-Allow-Origin;
        add_header Access-Control-Allow-Origin "*" always;
        # sessions must never be cached (default: nothing cached here)
    }

    location /rest/v1/ {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "$http_access_control_request_method" always;
            add_header Access-Control-Allow-Headers "$http_access_control_request_headers" always;
            add_header Access-Control-Max-Age "86400" always;
            return 204;
        }
        proxy_pass http://app_rest/;
        proxy_pass_request_headers on;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Expose-Headers;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Expose-Headers "Content-Profile" always;

        # --- microcache: GET/HEAD 200s, 5s TTL ---------------------------
        proxy_cache api;
        proxy_cache_key "$scheme://$host$request_uri|$http_apikey|$http_authorization";
        proxy_cache_methods GET HEAD;
        proxy_cache_valid 200 5s;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 5s;
        proxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        add_header X-Microcache $upstream_cache_status always;
    }

    # Optional: let the CDN itself cache hashed static assets long-term
    # (filenames contain content hashes, safe). index.html stays fresh.
    #location ~* ^/assets/.+\.[0-9a-f]{8}\.(js|css|png|svg|woff2)$ {
    #    proxy_pass http://app_web;
    #    proxy_cache api;
    #    proxy_cache_valid 200 1h;
    #    add_header X-Microcache $upstream_cache_status always;
    #}

    location / {
        proxy_pass http://app_web;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}


# =============================================================================
# .env.prod.example — copy to .env.prod and fill. NEVER commit .env.prod.
#   cp .env.prod.example .env.prod
# POSTGRES_PASSWORD must stay URL-safe (letters+digits only): it is embedded
# in postgres:// connection strings. Avoid @ / : ? # and single quotes.
# =============================================================================

# --- database (also sets the authenticator role password at init) ---
POSTGRES_PASSWORD=CHANGE_ME_32_HEX_ALNUM

# --- Supabase JWT: legacy symmetric HS256, shared signer+verifier secret ---
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_HEX

# --- API keys: HS256 JWTs signed with JWT_SECRET (NOT random strings) ---
# Generate both (needs node; same pattern as dev.sh):
#   node --input-type=module -e '
#   import crypto from "node:crypto";
#   const s = process.env.JWT_SECRET;
#   for (const role of ["anon", "service_role"]) {
#     const b64 = (b) => Buffer.from(b).toString("base64url");
#     const h = b64(JSON.stringify({ alg: "HS256", typ: "JWT" }));
#     const now = Math.floor(Date.now() / 1000);
#     const p = b64(JSON.stringify({ role, iss: "supabase", iat: now, exp: now + 315360000 }));
#     const sig = crypto.createHmac("sha256", s).update(h + "." + p).digest("base64url");
#     console.log(role + "=" + h + "." + p + "." + sig);
#   }'
ANON_KEY=CHANGE_ME_ANON_JWT
SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE_JWT

# --- realtime (formats enforced by the image) ---
# Generate: openssl rand -base64 48   (must be >= 64 chars)
SECRET_KEY_BASE=CHANGE_ME_64PLUS_CHARS
# Generate: openssl rand -hex 8       (must be EXACTLY 16 chars)
REALTIME_DB_ENC_KEY=CHANGE_ME_16_HEX

# --- public URL: the EXTERNAL https origin served by your TLS front ---
# Single-host layout: https://<host>/rest/v1, /auth/v1, /realtime/v1 + app /.
VITE_SUPABASE_URL=https://feria.example.com

# --- host port publishing the plain-HTTP gateway (TLS front proxies here) ---
GATEWAY_PORT=8080

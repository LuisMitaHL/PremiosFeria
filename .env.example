# Copia este archivo a .env y completa los valores de tu instancia.
#
# Ambos son públicos: viajan en el bundle que sirve el navegador. La clave
# publicable no otorga nada por sí sola -- lo que un cliente puede leer o
# escribir lo deciden las políticas RLS y las funciones de la base, nunca esta
# clave. Aun así el archivo no se versiona: el día que alguien agregue aquí un
# valor que sí sea secreto, ya estará en el lugar correcto.
VITE_SUPABASE_URL=http://localhost:3000
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
